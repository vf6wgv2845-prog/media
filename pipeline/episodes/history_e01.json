 "script": {
  "p1": [
   [
    0.05,
    "In 1518, a city caught a dancing plague."
   ],
   [
    0.1,
    "And the doctors' cure was... more dancing."
   ]
  ],
  "p2": [
   [
    0.1,
    "Strasbourg. July fourteenth."
   ],
   [
    0.1,
    "A woman named Frau Troffea starts dancing in the street. No music."
   ]
  ],
  "p3": [
   [
    0.1,
    "She dances for days."
   ],
   [
    0.1,
    "Within a week, more than thirty people have joined her."
   ]
  ],
  "p4": [
   [
    0.1,
    "Within a month, one chronicle says: four hundred."
   ]
  ],
  "p5": [
   [
    0.1,
    "The city's doctors blame overheated blood."
   ],
   [
    0.1,
    "Their prescription? Dance it out."
   ]
  ],
  "p6": [
   [
    0.1,
    "So the city turns guild halls into dance floors,"
   ],
   [
    0.05,
    "builds stages,"
   ],
   [
    0.05,
    "and hires musicians."
   ]
  ],
  "p7": [
   [
    0.1,
    "It backfires."
   ],
   [
    0.1,
    "Some accounts say dancers collapsed and died."
   ]
  ],
  "p8": [
   [
    0.1,
    "So the city bans music and dancing,"
   ],
   [
    0.1,
    "and sends the dancers to a shrine of Saint Vitus. In red shoes."
   ]
  ],
  "p9": [
   [
    0.1,
    "Nobody knows exactly why."
   ],
   [
    0.1,
    "The leading theory: mass panic, after years of famine."
   ]
  ],
  "sv": [
   [
    0.1,
    "Now it's on you."
   ],
   [
    0.1,
    "The top comment picks our next true story."
   ]
  ]
 },
