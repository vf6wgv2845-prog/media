 "script": {
  "p1": [
   [
    0.05,
    "In 1919, a wave of molasses swept through Boston."
   ],
   [
    0.1,
    "Thirty five miles an hour."
   ]
  ],
  "p2": [
   [
    0.1,
    "A fifty foot tank held two point three million gallons."
   ],
   [
    0.1,
    "It leaked, so the owners painted it brown."
   ]
