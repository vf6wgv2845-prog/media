  "p3": [
   [
    0.1,
    "January fifteenth, around lunchtime, it burst."
   ],
   [
    0.1,
    "The wave knocked an elevated train off its tracks."
   ]
  ],
  "p4": [
   [
    0.1,
    "Twenty one dead. About a hundred fifty hurt."
   ],
   [
    0.1,
    "It thickened as it cooled, and trapped people."
