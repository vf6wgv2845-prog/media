 "script": {
  "p1": [
   [
    0.05,
    "In 1939, America had two Thanksgivings."
   ],
   [
    0.1,
    "Depending on your state: one, the other, or both."
   ]
  ],
  "p2": [
   [
    0.1,
    "Stores wanted more shopping days before Christmas."
   ],
   [
    0.1,
    "So President Roosevelt moved it up a week."
   ]
  ],
  "p3": [
   [
    0.1,
    "Twenty-two states followed him. Twenty-three refused."
   ],
   [
    0.1,
    "Critics called it Franksgiving."
   ]
  ],
  "p4": [
   [
    0.1,
    "Football coaches rescheduled big games."
   ],
   [
    0.1,
    "Texas, Colorado and Mississippi celebrated both."
   ]
  ],
  "p5": [
   [
    0.1,
    "In 1941, Congress fixed it: the fourth Thursday."
   ],
   [
    0.1,
    "That's why it's tomorrow."
   ]
