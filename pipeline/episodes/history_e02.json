 "script": {
  "p1": [
   [
    0.05,
    "In 1637, a single tulip bulb could cost as much as a house."
   ],
   [
    0.1,
    "Then, in one week, nobody wanted them."
   ]
  ],
  "p2": [
   [
    0.1,
    "Tulips came to Europe from the Ottoman Empire."
   ],
   [
    0.1,
    "In the Dutch Republic, rare striped ones became the ultimate flex."
   ]
  ],
  "p3": [
   [
    0.1,
    "The most famous, the Semper Augustus, reportedly sold for ten thousand guilders."
   ],
   [
    0.1,
    "Its stripes? A virus."
   ]
  ],
  "p4": [
   [
    0.1,
    "A skilled craftsman earned about three hundred guilders a year."
   ]
  ],
  "p5": [
   [
    0.1,
    "Most bulbs were still in the ground."
   ],
   [
    0.1,
    "People traded paper promises to buy them later."
   ]
  ],
  "p6": [
   [
    0.1,
    "February third, 1637. A tulip sale in Haarlem."
   ],
   [
    0.1,
    "Nobody wants to buy."
   ]
  ],
  "p7": [
   [
    0.1,
    "Within a week, the market collapsed."
   ],
   [
    0.1,
    "Buyers just refused to pay."
   ]
  ],
  "p8": [
   [
    0.1,
    "The famous part? Ruined families, people in the canals."
   ],
   [
    0.1,
    "Historians say: mostly a myth."
   ]
  ],
  "p9": [
   [
    0.1,
    "Historian Anne Goldgar found a few hundred buyers,"
   ],
   [
    0.05,
    "and almost no bankruptcies."
   ]
  ],
  "sv": [
